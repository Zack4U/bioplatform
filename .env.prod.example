# ============================================================================
# BioPlatform Caldas — PRODUCTION environment template
# Copy to .env and fill REAL values:   cp .env.prod.example .env
# Every variable below is consumed by docker-compose.prod.yml. Nothing extra.
# Hostnames are docker service names; DB ports are INTERNAL (container) ports.
# ============================================================================

# ── SQL Server (Transaccional) ──────────────────────────────────────────────
DB_SQL_PASSWORD=ChangeMeDbPass_123
# Host = service "sqlserver", port 1433. Used by backend-core (ConnectionStrings__DefaultConnection).
DB_CONNECTION_STRING_SQL=Server=sqlserver,1433;Database=BioCommerce_Transactional;User Id=sa;Password=ChangeMeDbPass_123;TrustServerCertificate=True;Encrypt=False

# ── PostgreSQL + PostGIS (Científico) ───────────────────────────────────────
DB_PG_USER=bioadmin
DB_PG_PASSWORD=ChangeMeDbPass_123
DB_PG_DATABASE=BioCommerce_Scientific
# Host = service "postgres", INTERNAL port 5432. Used by backend-core (ConnectionStrings__ScientificConnection).
DB_CONNECTION_STRING_PG=Host=postgres;Port=5432;Database=BioCommerce_Scientific;Username=bioadmin;Password=ChangeMeDbPass_123
# (ai-service uses DB_PG_USER/PASSWORD/DATABASE directly via PG_* — no extra vars needed.)

# ── Redis (Caché + Hangfire) ────────────────────────────────────────────────
REDIS_PASSWORD=ChangeMeRedisPass_123
REDIS_CONNECTION_STRING=redis:6379,password=ChangeMeRedisPass_123,abortConnect=false

# ── JWT (compartido backend-core + ai-service) ──────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET
JWT_ISSUER=bioplatform-api
JWT_AUDIENCE=bioplatform-clients
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ── Poblado del catálogo científico ─────────────────────────────────────────
# true = backend-core puebla especies/imágenes/distribuciones en el 1er arranque (idempotente).
SEED_SCIENTIFIC_ON_STARTUP=true

# ── AWS S3 (subida de imágenes — backend-core) ──────────────────────────────
S3_BUCKET_NAME=bioplatform-public
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# ── AI Service — PyTorch device ─────────────────────────────────────────────
# cpu: sin GPU (default). cu121 / cu124: NVIDIA GPU (requiere nvidia-container-toolkit).
TORCH_DEVICE=cpu

# ── OpenAI (ai-service: RAG / planes de negocio) ────────────────────────────
OPENAI_API_KEY=sk-REPLACE_ME

# ── CORS / URLs ─────────────────────────────────────────────────────────────
# Origen público del frontend (backend-core: CorsSettings__AllowedOrigins).
WEB_APP_URL=http://localhost:3000
# Orígenes permitidos por ai-service (lista separada por comas).
CORS_ORIGINS=http://localhost:3000

# ── Frontend público (inyectado en build time) ──────────────────────────────
# Detrás de Nginx usa rutas relativas; para acceso directo usa URLs completas.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_AI_API_BASE_URL=/ai/api/v1
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_TAX_RATE=0
NEXT_PUBLIC_SHIPPING_COST_COP=15000
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=150000

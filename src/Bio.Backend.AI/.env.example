# ===========================================
# BioPlatform AI Service — Environment Variables
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ── Service ────────────────────────────────────────────────────
APP_NAME=BioPlatform AI Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── PostgreSQL (BioCommerce_Scientific) ────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=your_secure_password_here
PG_DATABASE=BioCommerce_Scientific

# ── JWT (shared with .NET Core backend) ────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_ISSUER=bioplatform-api
JWT_AUDIENCE=bioplatform-clients

# ── CNN Model ──────────────────────────────────────────────────
MODEL_WEIGHTS_PATH=data/weights/best_model.pth
BIO_MIN_F1_THRESHOLD=0.65

# ── Fine-Tuning Pipeline ──────────────────────────────────────
REPLAY_BUFFER_RATIO=0.15
DATASET_SPLIT_SEED=42
S3_BUCKET_NAME=bioplatform-public
PREFIX_AI_VERSION=v1.0
MIN_VRAM_GB=4.0
FINETUNE_DEFAULT_EPOCHS=15
FINETUNE_DEFAULT_LR=0.00001
VALIDATION_ACCURACY_DROP_THRESHOLD=0.05

# ── .NET Backend Integration ──────────────────────────────────
DOTNET_WEBHOOK_URL=http://bio-backend-api:5000/api/webhooks/ai/training-completed
DOTNET_API_BASE_URL=http://bio-backend-api:5000

# ── DVC ────────────────────────────────────────────────────────
DVC_REMOTE_NAME=myremote

# ── CORS (comma-separated origins) ────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── OpenAI (for RAG / Business Plans) ─────────────────────────
# OPENAI_API_KEY=sk-...

# ===========================================
# Amazon Web Services
# ===========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# ===========================================
# Google AI (for RAG / Business Plans) 
# ===========================================
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
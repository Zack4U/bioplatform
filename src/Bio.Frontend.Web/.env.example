# BioCommerce Caldas — Frontend Web (Next.js) environment variables
# Copy this file to .env.local and fill in the values.
# Only NEXT_PUBLIC_* vars are read by the app (inlined at build time).
# NEVER commit .env.local to version control.

# ─── API Backend (.NET Core) ─────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:5070/api

# ─── AI Microservice (Python FastAPI) ────────────────────────
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8000/api/v1

# ─── Cloudinary (Image CDN, used by SmartImage) ──────────────
# Get your cloud name from https://console.cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ─── Commerce settings (optional — sensible defaults in code) ─
# Tax rate as a fraction (e.g. 0.19 = 19% IVA). Default: 0.
NEXT_PUBLIC_TAX_RATE=0
# Flat shipping cost in COP. Default: 15000.
NEXT_PUBLIC_SHIPPING_COST_COP=15000
# Free-shipping order threshold in COP. Default: 150000.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=150000

# ─── App environment label ────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development

{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "SqlServer": "REPLACE_IN_DEVELOPMENT_JSON",
        "PostgreSql": "REPLACE_IN_DEVELOPMENT_JSON"
    },

    "JwtSettings": {
        "Secret": "REPLACE_IN_DEVELOPMENT_JSON",
        "Issuer": "bioplatform-api",
        "Audience": "bioplatform-clients",
        "ExpiryMinutes": 60,
        "RefreshTokenExpiryDays": 7
    },

    "RedisSettings": {
        "ConnectionString": "localhost:6379"
    },

    "StripeSettings": {
        "PublicKey": "REPLACE_IN_DEVELOPMENT_JSON",
        "SecretKey": "REPLACE_IN_DEVELOPMENT_JSON",
        "WebhookSecret": "REPLACE_IN_DEVELOPMENT_JSON"
    },

    "AiServiceSettings": {
        "BaseUrl": "http://localhost:8000"
    },

    "GeminiSettings": {
        "ApiKey": "REPLACE_IN_DEVELOPMENT_JSON"
    },

    "CorsSettings": {
        "AllowedOrigins": ["http://localhost:3000"]
    },

    "SerilogSettings": {
        "SeqUrl": "http://localhost:5341"
    },

    "AwsSettings": {
        "BucketName": "bioplatform-public",
        "Region": "us-east-1",
        "accessKeyId": "YOUR_ACCESS_KEY_ID",
        "secretAccessKey": "YOUR_SECRET_ACCESS_KEY"
    },

    "IdentificationSettings": {
        "MinConfidenceThreshold": 0.6
    }
}

{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "ConnectionStrings": {
        "DefaultConnection": "REPLACE_IN_DEVELOPMENT_OR_ENV",
        "ScientificConnection": "REPLACE_IN_DEVELOPMENT_OR_ENV",
        "RedisConnection": "localhost:6379,abortConnect=false"
    },

    "JwtSettings": {
        "Secret": "REPLACE_IN_DEVELOPMENT_OR_ENV",
        "Issuer": "bioplatform-api",
        "Audience": "bioplatform-clients",
        "ExpiryMinutes": 60,
        "RefreshTokenExpiryDays": 7
    },

    "AiService": {
        "BaseUrl": "http://localhost:8000"
    },

    "GeminiSettings": {
        "ApiKey": "REPLACE_IN_DEVELOPMENT_JSON"
    },

    "CorsSettings": {
        "AllowedOrigins": ["http://localhost:3000"]
    },

    "AwsSettings": {
        "BucketName": "bioplatform-public",
        "Region": "us-east-1",
        "AccessKeyId": "REPLACE_IN_DEVELOPMENT_OR_ENV",
        "SecretAccessKey": "REPLACE_IN_DEVELOPMENT_OR_ENV"
    },

    "IdentificationSettings": {
        "MinConfidenceThreshold": 0.6
    },

    "SeedSettings": {
        "SeedScientificOnStartup": false,
        "ScientificDataPath": "../../Bio.Backend.AI/data/species_catalog"
    }
}

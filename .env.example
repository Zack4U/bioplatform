# ============================================================================
# BioPlatform Caldas — DEVELOPMENT environment template (root .env)
# Copy to .env:   cp .env.example .env
#
# This root .env ONLY feeds docker-compose.yml + docker-compose.override.yml
# (the dev INFRASTRUCTURE: databases + UI tools). Each application reads its OWN
# env file when run locally:
#   - Backend Core (.NET): src/Bio.Backend.Core/Bio.API/appsettings.Development.json
#   - AI Service (Python):  src/Bio.Backend.AI/.env        (see .env.example there)
#   - Frontend Web (Next):  src/Bio.Frontend.Web/.env.local (see .env.example there)
#   - Frontend Mobile:      src/Bio.Frontend.Mobile/.env    (see .env.example there)
# For full production deploy see .env.prod.example.
# ============================================================================

# ── SQL Server (container: sqlserver) ───────────────────────────────────────
DB_SQL_PASSWORD=DevPassword123!

# ── PostgreSQL + PostGIS (container: postgres) ──────────────────────────────
DB_PG_USER=postgres
DB_PG_PASSWORD=DevPassword123!
DB_PG_DATABASE=BioCommerce_Scientific

# ── MongoDB (container: mongodb — profile "full", logs) ─────────────────────
MONGO_USER=mongo
MONGO_PASSWORD=DevPassword123!
MONGO_DATABASE=BioCommerce_Logs

# ── pgAdmin (container: pgadmin — docker-compose.override.yml) ──────────────
PGADMIN_DEFAULT_EMAIL=admin@bioplatform.dev
PGADMIN_DEFAULT_PASSWORD=admin123
